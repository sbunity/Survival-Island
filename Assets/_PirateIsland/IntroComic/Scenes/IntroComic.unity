  - {fileID: 1435444482}
  - {fileID: 110354475}
  - {fileID: 1174578002}
  - {fileID: 1250874734}
  - {fileID: 1805060868}
  - {fileID: 1623462567}
  panelTexts:
  - "\u041A\u0430\u043F\u0456\u0442\u0430\u043D \u043D\u0430\u043A\u0430\u0437\u0430\u0432
    \u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u043A\u0443\u0440\u0441, \u0445\u043E\u0447\u0430
    \u043C\u043E\u0440\u0435 \u0441\u0442\u0430\u0432\u0430\u043B\u043E \u0432\u0441\u0435
    \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0448\u0438\u043C\u2026"
  - "\u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0443 \u0440\u0438\u0444\u0438! \u0422\u0440\u0435\u0431\u0430
    \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u043A\u0443\u0440\u0441!\u041D\u0456!
    \u041C\u0438 \u043C\u0430\u0439\u0436\u0435 \u0434\u0456\u0441\u0442\u0430\u043B\u0438\u0441\u044F!"
  - "\u042F \u0431\u0443\u0432 \u043B\u0438\u0448\u0435 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u043C
    \u043C\u0430\u0442\u0440\u043E\u0441\u043E\u043C. \u041C\u0438 \u043D\u0435 \u0437\u043D\u0430\u043B\u0438,
    \u043A\u0443\u0434\u0438 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
    \u0432\u0435\u0434\u0435 \u043D\u0430\u0441 \u043A\u0430\u043F\u0456\u0442\u0430\u043D\u2026"
  - "\u041A\u0420\u0410\u0425!"
  - "\u0423\u0434\u0430\u0440 \u0431\u0443\u0432 \u0442\u0430\u043A\u0438\u043C \u0441\u0438\u043B\u044C\u043D\u0438\u043C,
    \u0449\u043E \u043A\u043E\u0440\u0430\u0431\u0435\u043B\u044C \u0440\u043E\u0437\u043B\u0435\u0442\u0456\u0432\u0441\u044F
    \u043D\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0438\u2026"
  - "\u041E\u0441\u0442\u0430\u043D\u043D\u0454, \u0449\u043E \u044F \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u044E,
    - \u0445\u043E\u043B\u043E\u0434\u043D\u0430 \u0432\u043E\u0434\u0430 \u0456
    \u0443\u043B\u0430\u043C\u043A\u0438 \u043D\u0430\u0432\u043A\u043E\u043B\u043E\u2026"
  - "\u041A\u043E\u043B\u0438 \u044F \u043F\u0440\u0438\u0439\u0448\u043E\u0432 \u0434\u043E
    \u0442\u044F\u043C\u0438, \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u0432\u0436\u0435
    \u043D\u0435 \u0431\u0443\u043B\u043E. \u041B\u0438\u0448\u0435 \u0443\u043B\u0430\u043C\u043A\u0438\u2026
    \u0456 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u0439 \u043E\u0441\u0442\u0440\u0456\u0432."
